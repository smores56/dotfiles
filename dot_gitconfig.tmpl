# Managed by chezmoi: ~/.gitconfig
#
# Identity lives here; owner-keyed includes below override the email and the
# signing key so personal and work commits keep their own keys without a
# per-repository thought. Paths are relative to the checkout root because the
# `repos` and `worktrees` wrappers keep every checkout beneath it.
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
    signingkey = {{ .personal_signing_key | quote }}

[init]
    defaultBranch = main

[core]
    excludesFile = ~/.config/git/ignore
    pager = delta

[pull]
    rebase = true

[push]
    default = simple
    autoSetupRemote = true

[fetch]
    prune = true
    # Deleting a stale remote-tracking branch is safe; deleting a tag is not.
    # Tags are release markers and may be local-only, so they never follow a
    # prune.
    pruneTags = false

[rebase]
    autosquash = true
    updateRefs = true

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true

[diff]
    algorithm = histogram
    colorMoved = default

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/ssh/allowed_signers

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta

[column]
    ui = auto

[help]
    autocorrect = prompt

[smores]
    # Rendered by `worktrees new`; {slug} {ticket} {type} are the placeholders.
    branchTemplate = smores/{slug}
    branchTemplateUnticketed = smores/{slug}
    flow = {{ .flow | quote }}
    # Read by `repos` for the employer's flat work layout; empty disables it.
    workFlat = {{ .work_flat_root | quote }}
    workOwners = {{ join " " .work_owners | quote }}

# Personal checkouts (including their worktrees, whose gitdir is under .git).
[includeIf "gitdir:{{ .repos_root }}/github.com/{{ .personal_owner }}/"]
    path = ~/.config/git/personal.inc
{{ range .work_owners }}
# Work checkouts for the {{ . }} owner.
[includeIf "gitdir:{{ $.repos_root }}/github.com/{{ . }}/"]
    path = ~/.config/git/work.inc
{{- end }}
{{- if .work_flat_root }}
# The employer's flat layout (<dir>/<repo>) is work, whatever the remote owner.
[includeIf "gitdir:{{ .work_flat_root }}/"]
    path = ~/.config/git/work.inc
{{- end }}

