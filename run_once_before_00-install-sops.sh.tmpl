#!/bin/sh
# chezmoi run_once_before: sops and age must exist before the managed files are
# applied, because dot_local/bin/executable_sops-age-key is what sops calls for
# the admin identity. Fedora Atomic mounts /usr read-only, so the pinned release
# binaries go into ~/.local/bin without root. Idempotent: the installed versions
# are checked first, so a re-run after a partial failure is safe.
set -eu

# Pinned releases, linux amd64. sops publishes a raw binary plus
# sops-v<version>.checksums.txt, so the download is verified against that file.
# age publishes sigsum proofs instead of a checksums file, so its tarball digest
# is pinned here; it is also the digest GitHub reports for that release asset.
SOPS_VERSION=3.13.3
AGE_VERSION=1.3.1
AGE_SHA256=bdc69c09cbdd6cf8b1f333d372a1f58247b3a33146406333e30c0f26e8f51377

bindir=$HOME/.local/bin

fail() {
    printf 'install-sops: %s\n' "$*" >&2
    exit 1
}

# macOS takes its packages from the Brewfile and no other platform has a pinned
# release here, so those only get a note: aborting would break the whole apply.
case $(uname -s)-$(uname -m) in
    Linux-x86_64) arch=amd64 ;;
    *) printf 'install-sops: no pinned sops %s or age %s build for %s-%s, skipping.\n' \
        "$SOPS_VERSION" "$AGE_VERSION" "$(uname -s)" "$(uname -m)"
       exit 0 ;;
esac

work=$(mktemp -d) || fail "could not create a temporary directory"
trap 'rm -rf "$work"' EXIT HUP INT TERM

mkdir -p "$bindir" || fail "could not create $bindir"

# Both probes read the binaries in $bindir rather than whatever PATH resolves, so
# the versions this file manages are the ones being checked.
if ! "$bindir/sops" --version 2>/dev/null | head -n 1 | grep -q "^sops $SOPS_VERSION "; then
    asset="sops-v$SOPS_VERSION.linux.$arch"
    base="https://github.com/getsops/sops/releases/download/v$SOPS_VERSION"
    curl -fL --proto '=https' --tlsv1.2 "$base/$asset" -o "$work/$asset" \
        || fail "sops: could not download $base/$asset"
    curl -fL --proto '=https' --tlsv1.2 "$base/sops-v$SOPS_VERSION.checksums.txt" \
        -o "$work/sops.checksums.txt" \
        || fail "sops: could not download $base/sops-v$SOPS_VERSION.checksums.txt"
    want=$(awk -v name="$asset" '$2 == name { print $1; exit }' "$work/sops.checksums.txt")
    got=$(sha256sum "$work/$asset" | awk '{ print $1 }')
    [ "$want" = "$got" ] || fail "sops: $asset is $got, not the published ${want:-nothing}"
    install -m 0755 "$work/$asset" "$bindir/sops" \
        || fail "sops: could not install $bindir/sops"
fi

if ! "$bindir/age" --version 2>/dev/null | grep -qx "v$AGE_VERSION"; then
    asset="age-v$AGE_VERSION-linux-$arch.tar.gz"
    url="https://github.com/FiloSottile/age/releases/download/v$AGE_VERSION/$asset"
    curl -fL --proto '=https' --tlsv1.2 "$url" -o "$work/$asset" \
        || fail "age: could not download $url"
    got=$(sha256sum "$work/$asset" | awk '{ print $1 }')
    [ "$got" = "$AGE_SHA256" ] || fail "age: $asset is $got, not $AGE_SHA256"
    # Only the two programs are installed; the tarball's docs stay in the temp dir.
    tar -xzf "$work/$asset" -C "$work" age/age age/age-keygen \
        || fail "age: could not extract from $url"
    install -m 0755 "$work/age/age" "$bindir/age" \
        || fail "age: could not install $bindir/age"
    install -m 0755 "$work/age/age-keygen" "$bindir/age-keygen" \
        || fail "age: could not install $bindir/age-keygen"
fi

printf 'sops %s and age %s are in %s\n' "$SOPS_VERSION" "$AGE_VERSION" "$bindir"
