# Development image used by `~/.local/bin/dev` when a repository has no
# Containerfile of its own. Fedora matches the Fedora Atomic host, so package
# names and SELinux behaviour are the same as on the laptop.
#
# Bump the base digest, Fedora release, and MISE_VERSION together, deliberately,
# like the pins in ~/.config/mise/config.toml.
FROM registry.fedoraproject.org/fedora:43@sha256:01aab1ff7df0cde68d5994e13a5639fe6524781a3664d69f5857e93b30508294

ARG MISE_VERSION=v2026.11.9

# No MISE_TRUSTED_CONFIG_PATHS here: `dev` sets it to the checkout it mounts,
# so one repository's mise config is never trusted by default.
ENV LANG=C.UTF-8 \
    SHELL=/usr/bin/zsh \
    MISE_DATA_DIR=/home/dev/.local/share/mise \
    MISE_YES=1

RUN dnf -y install --setopt=install_weak_deps=False \
        bash bat ca-certificates curl diffutils eza fd-find findutils \
        gh git git-delta git-lfs gzip jq just less make man-db openssh-clients \
        procps-ng python3 python3-pip ripgrep shellcheck tar unzip util-linux uv \
        which xz yq zsh \
    && dnf -y clean all \
    && rm -rf /var/cache/dnf

# mise from its pinned release tarball: the release's published sha256 is
# checked before unpacking, so no remote script runs and the artifact is fixed
# by content, not by tag alone.
RUN case "$(uname -m)" in \
        x86_64) arch=linux-x64; sha=23ba592fcbc61f057e2b82c1eafd085832712ba0c759b714ca16cd06babca378 ;; \
        aarch64) arch=linux-arm64; sha=cf2900bfb4279f8d8f8a19d5c27bf1bde826b3e742182f3f67511c588498c786 ;; \
        *) echo "unsupported architecture for mise" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-${arch}.tar.gz" -o /tmp/mise.tar.gz \
    && echo "${sha}  /tmp/mise.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/mise.tar.gz -C /tmp \
    && install -m 0755 /tmp/mise/bin/mise /usr/local/bin/mise \
    && rm -rf /tmp/mise /tmp/mise.tar.gz

# 1777 keeps the home usable when the engine maps an arbitrary host uid onto
# the container (Docker without keep-id); volumes cover the writable subdirs.
RUN useradd --create-home --uid 1000 dev \
    && mkdir -p /home/dev/.local/share/mise /home/dev/.config \
    && chown -R dev:dev /home/dev \
    && chmod 1777 /home/dev

# An empty .zshrc keeps zsh's first-run wizard from waiting on the terminal.
RUN touch /home/dev/.zshrc && chown dev:dev /home/dev/.zshrc

USER 1000
WORKDIR /home/dev
CMD ["zsh"]
