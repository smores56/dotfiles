# Load order matters; see the #717 design. Every module is an external path
# cloned by [bootstrap.repos], so zimfw never fetches.
_p=${XDG_DATA_HOME:-$HOME/.local/share}/zsh-plugins
zmodule $_p/environment
zmodule $_p/input
zmodule $_p/termtitle
zmodule $_p/utility
zmodule $_p/zsh-abbr
zmodule $_p/completion
# fzf-tab after compinit and before anything that wraps widgets.
zmodule $_p/fzf-tab
zmodule $_p/zsh-autosuggestions
zmodule $_p/zsh-autosuggestions-abbreviations-strategy
# Linux needs notify-send; without it the plugin prints a warning at every start.
zmodule $_p/zsh-auto-notify --source auto-notify.plugin.zsh \
  --if '[[ $OSTYPE == darwin* ]] || (( $+commands[notify-send] ))'
zmodule $_p/pure --source async.zsh --source pure.zsh
# Highlighting last, so it sees every widget.
zmodule $_p/fast-syntax-highlighting
zmodule $_p/fast-abbr-highlighting
unset _p
