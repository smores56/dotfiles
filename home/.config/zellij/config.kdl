default_shell "fish"
session_serialization false
// The web client is refused unless the session was created with sharing on,
// and it is read once at creation: SSH-started sessions need this line, while
// browser-started ones force it on themselves.
web_sharing "on"
show_startup_tips false

theme "ansi"

// A tab left at its default name with one pane shows that pane's OSC title
// (fish sets it to the foreground command and cwd) instead of "Tab #N".
pane_frame_style "titles"

ui {
    pane_frames {
        rounded_corners true
    }
}

keybinds {
    normal {
        // Alt+arrows belong to the terminal apps (word jumps).
        unbind "Alt Left" "Alt Right" "Alt Up" "Alt Down" "Ctrl q"

        bind "Ctrl Alt Left"  { MoveFocusOrTab "Left"; }
        bind "Ctrl Alt Right" { MoveFocusOrTab "Right"; }
        bind "Ctrl Alt Down"  { MoveFocus "Down"; }
        bind "Ctrl Alt Up"    { MoveFocus "Up"; }

        // Attention first: go-to-next-attention exits 2 when nothing is
        // counted, so fall back to the session manager (inbox tab when it
        // has rows, sessions when empty). Background keeps it invisible.
        bind "Ctrl Alt i" {
            Run "sh" "-c" "zellij action go-to-next-attention || zellij action launch-or-focus-plugin zellij:session-manager --floating --move-to-focused-tab" {
                background true
            }
        }
    }
}
