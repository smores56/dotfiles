// A calm focus tab: static screensaver gutters around a 120-column working pane.
// The frame is drawn inside the 120 columns, so the pane is 118 usable; below
// roughly 122 terminal columns the two gutters collapse, since Zellij has no
// native max-width mode that would shrink the centre instead.
layout {
    pane size=1 borderless=true {
        plugin location="zellij:bars" {
            role "tab-bar"
        }
    }
    pane split_direction="vertical" {
        pane borderless=true {
            command "screensavers"
        }
        pane size=120 focus=true
        pane borderless=true {
            command "screensavers"
        }
    }
    pane size=1 borderless=true {
        plugin location="zellij:bars" {
            role "status-bar"
        }
    }
}
