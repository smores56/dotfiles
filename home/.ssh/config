# Managed file: ~/.ssh/config, symlinked by install.sh.
#
# One multiplexed transport per destination, known hosts under ~/.config/ssh,
# and no agent or key invention. github.com gets a fixed user so
# `git@github.com:` URLs resolve.
Host github.com
    HostName github.com
    User git

Host *
    Compression no
    ServerAliveInterval 0
    ServerAliveCountMax 3
    HashKnownHosts no
    UserKnownHostsFile ~/.config/ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
