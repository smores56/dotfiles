#!/usr/bin/env bash
# Rio's Flatpak allocates the PTY inside its sandbox and hands it to a host
# shell, so the terminal's /dev/pts entry does not exist in the host mount
# namespace. ttyname(3) then fails with ENODEV, and Fedora's
# /etc/profile.d/gnupg2.sh turns the `tty` it runs for GPG_TTY into
# "tty: ttyname error: No such device" on every new terminal.
#
# Fall back to /dev/tty: the kernel resolves it from the controlling terminal
# without a devpts path lookup, so GPG_TTY still names the usable device.
set -eu

# -s only reports whether stdin is a terminal; keep its no-output contract.
case ${1-} in
    -s|--silent|--quiet) exec /usr/bin/tty "$@" ;;
esac

if out=$(/usr/bin/tty 2>/dev/null); then
    printf '%s\n' "$out"
elif [ -t 0 ]; then
    printf '/dev/tty\n'
else
    printf 'not a tty\n'
    exit 1
fi
