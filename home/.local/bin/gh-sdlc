#!/bin/sh
# gh sdlc: gh-dash configured for the sdlc registry.
#
# The config's section filters name this repo, so the wrapper pins the same
# registry and the gh transport instead of inheriting a work environment's
# SDLC_REPO/SDLC_TRANSPORT. SHELL=/bin/sh makes the fixed keymap snippets POSIX
# regardless of the login shell.
set -eu

config=${SDLC_GH_DASH_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/sdlc/gh-dash.yml}
[ -f "$config" ] || {
    printf 'gh sdlc: config not found: %s\n' "$config" >&2
    printf 'gh sdlc: re-apply dotfiles, or set SDLC_GH_DASH_CONFIG\n' >&2
    exit 2
}

command -v gh >/dev/null 2>&1 || {
    printf 'gh sdlc: gh is not on PATH\n' >&2
    exit 127
}

SDLC_REPO=smores56/sdlc
SDLC_TRANSPORT=gh
GH_NO_UPDATE_NOTIFIER=1
SHELL=/bin/sh
export SDLC_REPO SDLC_TRANSPORT GH_NO_UPDATE_NOTIFIER SHELL

if ! gh dash --version >/dev/null 2>&1; then
    printf 'gh sdlc: gh-dash is not installed\n' >&2
    printf 'gh sdlc: run gh extension install dlvhdr/gh-dash --pin v4.26.3\n' >&2
    exit 127
fi

exec gh dash --config "$config" "$@"
