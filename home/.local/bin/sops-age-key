#!/usr/bin/env bash
# SOPS_AGE_KEY_CMD: print the age identity, the YubiKey handle when present,
# else the passphrase-wrapped admin key, so it never sits in argv or the env.
set -eu

# sops folds a failing command's stderr into its own error, so repeat the reason
# on the tty where the operator is actually looking.
fail() {
    printf 'sops-age-key: %s\n' "$*" >&2
    { printf 'sops-age-key: %s\n' "$*" >/dev/tty; } 2>/dev/null || true
    exit 1
}

config=${XDG_CONFIG_HOME:-$HOME/.config}

# sops loads this plaintext default even when SOPS_AGE_KEY_CMD is set, so a
# leftover key would decrypt without ever asking for the passphrase.
legacy=$config/sops/age/keys.txt
if [ -e "$legacy" ]; then
    fail "remove the retired plaintext identity $legacy"
fi

# No fallback: while the handle is readable, sops sees only it; removing the
# file is the way back to the admin identity.
fido2=$config/sops/fido2-identity.txt
if [ -r "$fido2" ]; then
    exec cat "$fido2"
fi

key=$config/sops/keys.age
if [ ! -r "$key" ]; then
    fail "$key is missing or unreadable;" \
        "provision the passphrase-wrapped admin age identity there," \
        "or the YubiKey identity at $fido2"
fi

exec age --decrypt "$key"
