#!/bin/bash
# SOPS_AGE_KEY_CMD: answer one stanza's recipient with one identity. sops runs
# this once per recipient stanza and passes the stanza's recipient in
# SOPS_AGE_RECIPIENT, so reply for that recipient alone: the matching YubiKey
# handle, or the passphrase-wrapped admin identity when no token is usable.
# Nothing secret lands in argv or the environment.
set -eu

# sops captures the command's stderr and drops it; the tty copy is the only
# channel the operator sees, and it disappears without a controlling terminal.
fail() {
    printf 'sops-age-key: %s\n' "$*" >&2
    { printf 'sops-age-key: %s\n' "$*" >/dev/tty; } 2>/dev/null || true
    exit 1
}

note() {
    printf 'sops-age-key: %s\n' "$*" >&2
    { printf 'sops-age-key: %s\n' "$*" >/dev/tty; } 2>/dev/null || true
}

# The recipient comes from the ciphertext, so it is untrusted bytes on a tty.
safe() { printf '%s' "$1" | LC_ALL=C tr -c '[:print:]' '?'; }

config=${XDG_CONFIG_HOME:-$HOME/.config}
fido2=$config/sops/fido2-identity.txt
key=$config/sops/keys.age
legacy=$config/sops/age/keys.txt
recipient=${SOPS_AGE_RECIPIENT:-}
# A project mise config can put a hostile `age` first on PATH; SOPS_AGE_BIN is
# resolved once from the global config by the shell env and pins this exec.
age_bin=${SOPS_AGE_BIN:-age}

# A root process must never execute this user-writable command. $EUID is a bash
# builtin, so a planted `id` cannot skip the check. Root's identity path is
# fixed, never derived from an environment root could inherit.
if [ "$EUID" -eq 0 ]; then
    legacy=/root/.config/sops/age/keys.txt
    if [ "${1:-}" = --check ]; then
        if [ ! -s "$legacy" ]; then
            printf 'sops-age-key: root identity %s is missing\n' "$legacy" >&2
            exit 1
        fi
        IFS= read -r first <"$legacy" || first=
        prefix='AGE-SECRET-'
        case $first in
            "${prefix}KEY-1"* | "${prefix}KEY-PQ-1"*) exit 0 ;;
        esac
        printf 'sops-age-key: %s is not a plaintext age identity\n' "$legacy" >&2
        exit 1
    fi
    exit 0
fi

# sops loads these independently of SOPS_AGE_KEY_CMD; any of them would bypass
# this wrapper and the retired-plaintext guard.
if [ -n "${SOPS_AGE_KEY:-}" ] || [ -n "${SOPS_AGE_KEY_FILE:-}" ] \
        || [ -n "${SOPS_AGE_SSH_PRIVATE_KEY_CMD:-}" ] \
        || [ -n "${SOPS_AGE_SSH_PRIVATE_KEY_FILE:-}" ]; then
    fail "unset SOPS_AGE_KEY, SOPS_AGE_KEY_FILE and the SOPS_AGE_SSH_PRIVATE_KEY_* vars;" \
        "sops-age-key owns the identity"
fi

# sops loads this plaintext default even when SOPS_AGE_KEY_CMD is set, so a
# leftover key would decrypt without ever asking for the passphrase.
if [ -s "$legacy" ]; then
    fail "remove the retired plaintext identity $legacy"
fi

# systemd-cryptenroll lists the FIDO devices it can open, so the logind uaccess
# ACL is part of the answer: a key visible over SSH without a seat is not
# usable, and the plugin would otherwise poll for 50 s instead of failing fast.
fido2_present() {
    case ${SOPS_AGE_FIDO2_PRESENT:-} in
        0)
            note "SOPS_AGE_FIDO2_PRESENT=0; using the passphrase identity"
            return 1
            ;;
        1)
            note "SOPS_AGE_FIDO2_PRESENT=1; assuming a token is attached"
            return 0
            ;;
    esac
    if command -v systemd-cryptenroll >/dev/null 2>&1; then
        systemd-cryptenroll --fido2-device=list 2>/dev/null | grep -q '^/dev/hidraw'
        return
    fi
    # macOS has no seat/uaccess split, so presence is usable.
    if command -v ioreg >/dev/null 2>&1; then
        ioreg -p IOUSB -l -w 0 2>/dev/null | grep -qi yubico
        return
    fi
    note "no FIDO probe available; using the passphrase identity"
    return 1
}

valid_key() {
    [ -f "$key" ] && [ -s "$key" ] \
        && [ "$(head -c 14 "$key" 2>/dev/null)" = "age-encryption" ]
}

# identity_for <recipient>: print the one identity line whose block names the
# recipient. 0 found, 1 no match, 2 malformed or duplicated, 3 unowned handle.
identity_for() {
    local recip=$1 found
    [ -n "$recip" ] || return 1
    [ -r "$fido2" ] || return 1
    found=$(RECIPIENT="$recip" awk '
        BEGIN { r = ENVIRON["RECIPIENT"] }
        { sub(/\r$/, "") }
        /^# public key: / { pk = $4; next }
        /^AGE-PLUGIN-/ {
            if (pk == "") { bad = 1; exit }
            if (pk == r) { print; n++ }
            pk = ""
        }
        END { if (bad) exit 3; if (n > 1) exit 2; if (n == 0) exit 1 }
    ' "$fido2") || return $?
    printf '%s\n' "$found" | grep -Eq '^AGE-PLUGIN-FIDO2-HMAC-1[0-9A-Za-z]+$' || return 2
    printf '%s\n' "$found"
}

# Emitting a handle set is only safe when every line validates: sops discards
# every identity from a location that fails to parse.
all_handles() {
    [ -r "$fido2" ] || return 1
    awk '
        { sub(/\r$/, "") }
        /^# public key: / { pk = $4; next }
        /^AGE-PLUGIN-/ {
            if (pk == "") { bad = 1; exit }
            if ($0 !~ /^AGE-PLUGIN-FIDO2-HMAC-1[0-9A-Za-z]+$/) { bad = 1; exit }
            print; n++; pk = ""
        }
        END { if (bad) exit 2; if (n == 0) exit 1 }
    ' "$fido2"
}

admin_identity() {
    if ! valid_key; then
        fail "$key is missing, empty, or not an age identity;" \
            "provision the passphrase-wrapped admin age identity there," \
            "or a YubiKey identity in $fido2"
    fi
    exec "$age_bin" --decrypt "$key"
}

# Shared identity predicate for scripts/secrets.sh: can this machine produce an
# identity, and can the helper it needs actually run? No age call.
if [ "${1:-}" = --check ]; then
    # A readable handle file must validate, or every stanza that names a handle
    # hard-fails even while the predicate reports ready.
    if [ -r "$fido2" ]; then
        hs=0
        all_handles >/dev/null 2>&1 || hs=$?
        [ "$hs" -eq 2 ] && exit 1
    fi
    if valid_key && command -v "$age_bin" >/dev/null 2>&1; then
        exit 0
    fi
    if fido2_present && command -v age-plugin-fido2-hmac >/dev/null 2>&1 \
            && all_handles >/dev/null 2>&1; then
        exit 0
    fi
    printf 'sops-age-key: no usable SOPS identity (token, keys.age, or helper)\n' >&2
    exit 1
fi

status=0
found=$(identity_for "$recipient") || status=$?
case $status in
    0)
        fido2_present \
            || fail "$(safe "$recipient") needs an attached YubiKey; plug one in," \
                "or unplug it and let the admin stanza ask for the passphrase"
        printf '%s\n' "$found"
        exit 0
        ;;
    1) ;;
    2) fail "$fido2 has a malformed or duplicated identity for $(safe "$recipient")" ;;
    3) fail "$fido2 has an AGE-PLUGIN line with no # public key: comment" ;;
    *) fail "identity lookup failed with status $status for $(safe "$recipient")" ;;
esac

if [ -n "$recipient" ]; then
    # A token is preferred; emit nothing and let sops try the keys. With no
    # token, a recipient with no local handle is the admin stanza, and every
    # rule lists &admin first, so this prompts once.
    fido2_present && exit 0
    admin_identity
fi

# No recipient: older sops, or a manual run. Prefer the token, else the key.
if fido2_present; then
    hs=0
    handles=$(all_handles) || hs=$?
    [ "$hs" -eq 2 ] && fail "$fido2 has an invalid handle"
    if [ "$hs" -eq 0 ]; then
        printf '%s\n' "$handles"
        exit 0
    fi
fi
admin_identity
