#!/usr/bin/env bash
# sops runs this through SOPS_AGE_KEY_CMD and reads the age identity from stdout;
# age prompts for the passphrase on the tty, so the identity never appears in
# argv or in the environment. The YubiKey identity is exported the same way, and
# that one is unwrapped by the token, not by a passphrase.
set -eu

# sops folds a failing command's stderr into its own error, so repeat the reason
# on the tty where the operator is actually looking.
fail() {
    printf 'sops-age-key: %s\n' "$*" >&2
    { printf 'sops-age-key: %s\n' "$*" >/dev/tty; } 2>/dev/null || true
    exit 1
}

config=${XDG_CONFIG_HOME:-$HOME/.config}

# sops loads this plaintext default even when SOPS_AGE_KEY_CMD is set, so a
# leftover key would decrypt without ever asking for the passphrase.
legacy=$config/sops/age/keys.txt
if [ -e "$legacy" ]; then
    fail "remove the retired plaintext identity $legacy"
fi

# The YubiKey identity wins when it is provisioned: it is a plaintext
# age-plugin-fido2-hmac handle that the token unlocks, so nothing here can leak
# a long-term secret, and sops decrypts with whichever key is at hand. Removing
# this file is the documented fallback to the admin identity.
fido2=$config/sops/fido2-identity.txt
if [ -r "$fido2" ]; then
    exec cat "$fido2"
fi

key=$config/sops/keys.age
# Checked here so the error names the file to provision instead of age's generic
# passphrase prompt.
if [ ! -r "$key" ]; then
    fail "$key is missing or unreadable;" \
        "provision the passphrase-wrapped admin age identity there," \
        "or the YubiKey identity at $fido2"
fi

exec age --decrypt "$key"
