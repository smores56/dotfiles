#!/bin/sh
# ssh's ProxyCommand for smortress: `cloudflared access ssh` with the Access
# service token. An ssh started from the GUI or a unit has no shell profile, so
# the token comes from a mode-600 file and reaches only cloudflared's
# environment. $1 is the hostname from ~/.ssh/smortress.conf.
set -eu

host=${1:-ssh.sammohr.dev}
env_file=${SMORTRESS_ACCESS_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/cloudflare/access.env}

fail() { printf 'smortress-ssh: %s\n' "$*" >&2; exit 1; }

command -v cloudflared >/dev/null 2>&1 \
    || fail 'cloudflared is not on PATH; run mise bootstrap'

[ -r "$env_file" ] \
    || fail "no Access service token at $env_file; run scripts/secrets.sh"

mode=$(stat -c %a "$env_file" 2>/dev/null || stat -f %Lp "$env_file")
[ "$mode" = 600 ] || fail "$env_file is mode $mode, not 600"

value_of() {
    v=$(sed -n "s/^${1}=//p" "$env_file" | head -n 1 | tr -d '\r')
    case $v in
        \"*\") v=${v#\"}; v=${v%\"} ;;
        \'*\') v=${v#\'}; v=${v%\'} ;;
    esac
    printf '%s' "$v"
}

client_id=$(value_of CLOUDFLARE_ACCESS_CLIENT_ID)
client_secret=$(value_of CLOUDFLARE_ACCESS_CLIENT_SECRET)
if [ -z "$client_id" ] || [ -z "$client_secret" ]; then
    fail "$env_file must set CLOUDFLARE_ACCESS_CLIENT_ID and CLOUDFLARE_ACCESS_CLIENT_SECRET"
fi

# cloudflared's own names for the pair; flags would put the secret in argv.
TUNNEL_SERVICE_TOKEN_ID=$client_id
TUNNEL_SERVICE_TOKEN_SECRET=$client_secret
export TUNNEL_SERVICE_TOKEN_ID TUNNEL_SERVICE_TOKEN_SECRET

exec cloudflared access ssh --hostname "$host"
