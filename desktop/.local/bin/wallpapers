#!/bin/sh
# Mirror smortress's wallpapers (`tailscale serve` at /wallpapers, device-
# authenticated, so no credential) into a cache, then give every display an
# unshown image of its aspect through Noctalia's IPC. Noctalia's own rotation
# stays off because its state file would outrank this queue.
# WALLPAPERS_SOURCE, WALLPAPERS_RCLONE and WALLPAPERS_CACHE override the defaults.
set -eu

source=${WALLPAPERS_SOURCE:-}
cache=${WALLPAPERS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/wallpapers}
dest=$cache/Wallpapers
state=${XDG_STATE_HOME:-$HOME/.local/state}/wallpapers

log() { printf 'wallpapers: %s\n' "$*" >&2; }
usage() {
    log "usage: wallpapers [sync|apply|classify W H|pick LIST QUEUE [USED]|unpick QUEUE FILE|buckets DIR OUT]"
    exit 2
}

# 16:9 (1.78) is standard, 21:9 (2.33)+ ultrawide; 2.0 splits them.
bucket_of() {
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
    case "$1$2" in
        *[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 0 ] && [ "$2" -gt 0 ] || return 1
    if awk -v w="$1" -v h="$2" 'BEGIN { exit !(w / h >= 2.0) }'; then
        printf 'Ultrawide\n'
    else
        printf 'Standard\n'
    fi
}

find_rclone() {
    [ -n "${WALLPAPERS_RCLONE:-}" ] && { printf '%s\n' "$WALLPAPERS_RCLONE"; return 0; }
    for candidate in "$(command -v rclone 2>/dev/null || true)" \
            "$HOME/.local/bin/rclone" "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/rclone"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# The tailnet suffix is read from tailscaled rather than pinned here.
source_url() {
    if [ -n "$source" ]; then
        printf '%s\n' "$source"
        return 0
    fi
    # Without jq the parse below yields an empty name, which would blame
    # tailscaled for a missing package.
    if ! command -v jq >/dev/null 2>&1; then
        log "jq is required to read the tailnet name from tailscaled and is not on PATH"
        return 1
    fi
    status=$(tailscale status --json 2>/dev/null) || status=
    dns=$(printf '%s' "$status" | jq -r '.Self.DNSName // empty' 2>/dev/null) || dns=
    dns=${dns%.}
    suffix=${dns#*.}
    if [ -z "$dns" ] || [ "$suffix" = "$dns" ]; then
        log "cannot read the tailnet name from tailscaled; set WALLPAPERS_SOURCE"
        return 1
    fi
    printf 'https://smortress.%s/wallpapers/\n' "$suffix"
}

remote_url() {
    url=$1
    case $url in
        http://* | https://*) ;;
        *)
            log "WALLPAPERS_SOURCE must be an http(s) URL, not $url"
            return 1
            ;;
    esac
    printf ":http,url='%s':" "$url"
}

# The timer and a manual run must not classify under each other's deletes.
lock() {
    mkdir -p "$cache" "$state"
    exec 9>"$cache/.lock"
    if ! flock -n 9; then
        log "another run holds $cache/.lock; skipping"
        exit 0
    fi
}

sync_cache() {
    rclone_bin=$(find_rclone) \
        || { log 'rclone is required; run mise bootstrap'; return 1; }
    url=$(source_url) || return 1
    remote=$(remote_url "$url") || return 1
    mkdir -p "$dest"
    # Probe before syncing, so an unreachable host never empties the cache.
    # Top-level entries may be directories (the canonical tree groups images by
    # aspect), so a --files-only probe reports an exposed tree as empty.
    if ! listing=$("$rclone_bin" lsf "$remote" --max-depth 1 \
            --contimeout 20s --timeout 240s --retries 2 2>/dev/null); then
        log "cannot list $url; keeping the cached set"
        return 1
    fi
    if [ -z "$listing" ]; then
        log "source listing is empty; keeping the cached set"
        return 1
    fi
    "$rclone_bin" sync "$remote" "$dest" \
        --contimeout 20s --timeout 780s --retries 2 --stats 0
}

# Bucket by measured pixels, not folder: images get misfiled.
classify_cache() {
    dir=$1
    out=$2
    if [ ! -d "$dir" ]; then
        log "no cached wallpapers at $dir yet"
        return 1
    fi
    mkdir -p "$out"
    : >"$out/Standard.list"
    : >"$out/Ultrawide.list"
    # One identify process per batch: process startup dominates when every file
    # gets its own. %i labels each frame, and the first frame of an animated
    # image is the only one that should decide the aspect.
    find "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
            -o -iname '*.webp' -o -iname '*.jxl' \) -print0 |
        xargs -0 -r -n 64 identify -ping -format '%w %h %i\n' 2>/dev/null |
        awk '{ file = $0; sub(/^[^ ]+ [^ ]+ /, "", file) }
             !seen[file]++ { print $1 "\t" $2 "\t" file }' |
        while IFS="$(printf '\t')" read -r width height file; do
            if bucket=$(bucket_of "${width:-}" "${height:-}"); then
                printf '%s\n' "$file" >>"$out/$bucket.list"
            fi
        done
    LC_ALL=C sort -o "$out/Standard.list" "$out/Standard.list"
    LC_ALL=C sort -o "$out/Ultrawide.list" "$out/Ultrawide.list"
}

# Random without replacement: each aspect keeps a queue of unshown images, and
# <used> holds what this run already placed so two displays of one aspect cannot
# get the same picture.
next_pick() {
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
        usage
    fi
    list=$1
    queue=$2
    used=${3:-}
    if [ ! -s "$list" ]; then
        log "no wallpapers in $list"
        return 1
    fi
    candidates=$queue.candidates
    if [ -n "$used" ] && [ -s "$used" ]; then
        awk 'NR == FNR { used[$0] = 1; next } !($0 in used)' \
            "$used" "$list" >"$candidates"
    else
        cp "$list" "$candidates"
    fi
    # Every image shown: start the cycle over rather than leave a display blank.
    if [ ! -s "$candidates" ]; then
        cp "$list" "$candidates"
    fi
    picked=
    if [ -s "$queue" ]; then
        : >"$queue.new"
        while IFS= read -r file; do
            grep -Fxq -e "$file" "$candidates" || continue
            if [ -z "$picked" ]; then
                picked=$file
            else
                printf '%s\n' "$file" >>"$queue.new"
            fi
        done <"$queue"
        mv "$queue.new" "$queue"
    fi
    if [ -z "$picked" ]; then
        shuffled=$queue.shuffled
        awk 'BEGIN { srand() } { printf "%.9f\t%s\n", rand(), $0 }' "$candidates" \
            | LC_ALL=C sort | cut -f2- >"$shuffled"
        picked=$(head -n 1 "$shuffled")
        tail -n +2 "$shuffled" >"$queue"
        rm -f "$shuffled"
    fi
    rm -f "$candidates"
    if [ -z "$picked" ]; then
        log "could not pick from $list"
        return 1
    fi
    printf '%s\n' "$picked"
}

# A display that could not be set must not consume its image: put it back at the
# head so the next run tries it again.
unpick() {
    queue=$1
    file=$2
    {
        printf '%s\n' "$file"
        if [ -s "$queue" ]; then
            cat "$queue"
        fi
    } >"$queue.new"
    mv "$queue.new" "$queue"
}

apply() {
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    classify_cache "$dest" "$work" || return 1
    # Outside a session (greetd, SSH) there is nothing to set: skip without
    # failing, so the oneshot never parks in a restart loop before login.
    if ! outputs=$(niri msg --json outputs); then
        log "niri msg failed (no session?); skipping"
        return 0
    fi
    # logical is post-transform, so a rotated display is bucketed by the shape a
    # wallpaper actually fills; fall back to the mode for older niri IPC.
    if ! printf '%s' "$outputs" | jq -r '
        to_entries[] | select(.value.current_mode != null) |
        (.value.logical // .value.modes[.value.current_mode]) as $m |
        "\(.key)\t\($m.width)\t\($m.height)"
    ' >"$work/displays"; then
        log "could not parse niri outputs; skipping"
        return 0
    fi
    if [ ! -s "$work/displays" ]; then
        log "no active outputs; skipping"
        return 0
    fi
    applied_count=0
    while IFS="$(printf '\t')" read -r connector width height; do
        if ! bucket=$(bucket_of "$width" "$height"); then
            log "$connector has an unusable mode ${width}x${height}; skipping"
            continue
        fi
        if ! picture=$(next_pick "$work/$bucket.list" \
                "$state/queue-$bucket" "$work/used-$bucket"); then
            log "$connector has no $bucket images; leaving it unchanged"
            continue
        fi
        log "$connector ${width}x${height} -> $bucket $(basename "$picture")"
        if ! noctalia msg wallpaper-set "$connector" "$picture"; then
            log "noctalia rejected $connector"
            unpick "$state/queue-$bucket" "$picture"
            continue
        fi
        applied=$(noctalia msg wallpaper-get "$connector") || {
            unpick "$state/queue-$bucket" "$picture"
            continue
        }
        if [ "$applied" != "$picture" ]; then
            log "$connector reports '$applied' after setting '$picture'"
            unpick "$state/queue-$bucket" "$picture"
            continue
        fi
        # Recorded only now: a pick that failed to land may go to the next
        # display of this aspect.
        printf '%s\n' "$picture" >>"$work/used-$bucket"
        applied_count=$((applied_count + 1))
    done <"$work/displays"
    if [ "$applied_count" -eq 0 ]; then
        # Retrying immediately cannot help: the next timer tick picks again.
        log "no display could be set"
        return 0
    fi
}

case ${1:-sync} in
    sync)
        lock
        # Apply even when the sync failed: the cache is the source of truth, and
        # the failure still reaches the unit status.
        status=0
        sync_cache || status=$?
        apply_status=0
        apply || apply_status=$?
        if [ "$status" -eq 0 ]; then
            status=$apply_status
        fi
        exit "$status"
        ;;
    apply)
        lock
        apply
        ;;
    classify)
        shift
        if [ "$#" -ne 2 ]; then
            usage
        fi
        bucket_of "$1" "$2"
        ;;
    pick)
        shift
        next_pick "$@"
        ;;
    unpick)
        shift
        unpick "$@"
        ;;
    buckets)
        shift
        if [ "$#" -ne 2 ]; then
            usage
        fi
        classify_cache "$1" "$2"
        ;;
    *)
        usage
        ;;
esac
