#!/bin/sh
# Sync the canonical wallpaper tree into a local cache and pick one file.
#
# COSMIC (the desktop this repository targets) has no scriptable wallpaper
# setting, so `pick` selects a file and prints it: set it by hand in the
# desktop's Appearance settings. The systemd timer keeps the cache fresh.
# The source is the #660 path on the private host; override it with
# WALLPAPERS_SOURCE for a migration or a test.
#
# The sync uses rclone's SFTP backend, so no host sync package is needed: rclone is a
# mise tool, and the smortress key and known_hosts come from the identity env.
# WALLPAPERS_SOURCE is host:path; WALLPAPERS_USER, WALLPAPERS_KEY, and
# WALLPAPERS_KNOWN_HOSTS override the defaults below.
set -eu

source=${WALLPAPERS_SOURCE:-smortress:/srv/wallpapers/}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/wallpapers
dest=$cache/Wallpapers
user=${WALLPAPERS_USER:-core}
key=${WALLPAPERS_KEY:-$HOME/.ssh/id_smortress-access}
known_hosts=${WALLPAPERS_KNOWN_HOSTS:-$HOME/.config/ssh/known_hosts}

log() { printf 'wallpapers: %s\n' "$*" >&2; }

rclone_bin=${WALLPAPERS_RCLONE:-}
if [ -z "$rclone_bin" ]; then
    for candidate in "$(command -v rclone 2>/dev/null || true)" \
            "$HOME/.local/bin/rclone" "$HOME/.local/share/mise/shims/rclone"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            rclone_bin=$candidate
            break
        fi
    done
fi
[ -n "$rclone_bin" ] || { log 'rclone is required; run mise bootstrap'; exit 1; }

remote_url() {
    host=${source%%:*}
    path=${source#*:}
    if [ "$host" = "$source" ] || [ -z "$path" ]; then
        log "WALLPAPERS_SOURCE must be host:path, not $source"
        exit 2
    fi
    [ -f "$known_hosts" ] \
        || { log "no known_hosts at $known_hosts; cannot verify $host"; exit 1; }
    opts="host=$host,user=$user,known_hosts_file=$known_hosts"
    if [ -f "$key" ]; then
        opts="$opts,key_file=$key"
    fi
    printf ':sftp,%s:%s' "$opts" "$path"
}

sync_cache() {
    remote=$(remote_url)
    mkdir -p "$cache" "$dest"
    # Probe before syncing, so an unreachable host never empties the cache.
    if ! listing=$("$rclone_bin" lsf "$remote" --files-only --max-depth 1 \
            --contimeout 20s --timeout 240s --retries 2 2>/dev/null); then
        log "cannot list $source; keeping the cached set"
        exit 1
    fi
    if [ -z "$listing" ]; then
        log "source listing is empty; keeping the cached set"
        exit 1
    fi
    "$rclone_bin" sync "$remote" "$dest" \
        --contimeout 20s --timeout 780s --retries 2 --stats 0
}

pick_one() {
    [ -d "$dest" ] || { log "no cached wallpapers at $dest"; exit 1; }
    file=$(find "$dest" -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        | awk 'BEGIN { srand() } { a[NR] = $0 } END { if (NR) print a[int(rand() * NR) + 1] }')
    [ -n "$file" ] || { log "no wallpapers in $dest"; exit 1; }
    log "selected $file; set it in COSMIC's Appearance settings"
}

case ${1:-} in
    sync) sync_cache ;;
    pick) pick_one ;;
    sync-and-pick) sync_cache; pick_one ;;
    *) printf 'usage: wallpapers sync|pick|sync-and-pick\n' >&2; exit 2 ;;
esac
