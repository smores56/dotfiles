<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sammohr.ssh-agent</string>
  <!-- launchd expands nothing, so the shell resolves $HOME. The socket lives
       under the login home rather than /tmp: another local user must not be
       able to find the agent by watching a shared directory, and the directory
       is 0700 before ssh-agent binds.
       The agent itself runs from scripts/ssh-agent-serve.sh, reached through a
       wrapper the bootstrap writes: launchd has no ExecStartPost, so the script
       is what loads the sudo credentials once the socket is bound. Without it
       every reboot starts an empty agent and every sudo after it costs a
       password. The stale socket is removed there, because ssh-agent -a refuses
       to bind over a file left behind by a crash and KeepAlive would then
       restart it into the same failure forever. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/ssh-agent-smortress"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
