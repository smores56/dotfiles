# Rendered by mise. Every checkout on this laptop is work: one identity, no
# personal routing.
[user]
    name = "Sam Mohr"
    email = "smohr@blitzy.com"
[smores]
    flow = "pr"
    branchTemplate = "{ticket}-{slug}"
    branchTemplateUnticketed = "{type}/{slug}"
    workFlat = "~/Blitzy"
    workOwners = "blitzy-ai blitzy-platform"
