# Rendered by mise. Every checkout on this laptop is work: one identity,
# signed by the checked-in 1Password public key, no personal routing.
[user]
    name = "Sam Mohr"
    email = "smohr@blitzy.com"
    signingkey = "~/.config/git/work-signing.pub"
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[smores]
    flow = "pr"
    branchTemplate = "{ticket}-{slug}"
    branchTemplateUnticketed = "{type}/{slug}"
    workFlat = "~/Blitzy"
    workOwners = "blitzy-ai blitzy-platform"
# Work repositories go over SSH through the 1Password agent; public GitHub
# (Homebrew taps, git dependencies) stays on https and needs no approval.
[url "git@github.com:blitzy-ai/"]
    insteadOf = https://github.com/blitzy-ai/
[url "git@github.com:blitzy-platform/"]
    insteadOf = https://github.com/blitzy-platform/
