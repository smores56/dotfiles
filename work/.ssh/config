# smortress over its Cloudflare tunnel, with no Tailscale on the employer's
# laptop: the same access key as the tailnet route, and the tunnel client (from
# `brew install cloudflared`) as the transport. Access asks for a browser login
# on first use and caches it for the session.
Host smortress ssh.sammohr.dev
    HostName ssh.sammohr.dev
    User smores
    IdentityFile ~/.ssh/id_smortress-access
    IdentitiesOnly yes
    ProxyCommand cloudflared access ssh --hostname %h
    StrictHostKeyChecking accept-new

Host *
    # Offer a key only where a host names one, never to every server.
    IdentitiesOnly yes
    Compression no
    ServerAliveInterval 0
    ServerAliveCountMax 3
    HashKnownHosts no
    UserKnownHostsFile ~/.config/ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
