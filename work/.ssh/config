# Managed file: ~/.ssh/config, linked from this checkout by mise.
#
# The smortress route lives in the include, which is the same sled the personal
# machines use: Cloudflare Access is the only route, and the wrapper named there
# supplies the service token. Nothing here needs Tailscale on the employer's
# laptop.
Include ~/.ssh/smortress.conf

Host *
    # Offer a key only where a host names one, never to every server.
    IdentitiesOnly yes
    Compression no
    ServerAliveInterval 0
    ServerAliveCountMax 3
    HashKnownHosts no
    UserKnownHostsFile ~/.config/ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
