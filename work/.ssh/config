# smoreswork: work GitHub only. 1Password's SSH agent holds the work key, so
# no private key is on disk; every use is approved in the 1Password app.
Host github.com
    HostName github.com
    User git
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    # Offer only the work key, and learn GitHub's host key on first use so a
    # headless push does not stop at verification.
    IdentityFile ~/.config/git/work-signing.pub
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

# smortress over its Cloudflare tunnel, with no Tailscale on the employer's
# laptop: the same access key as the tailnet route, and the tunnel client (from
# `brew install cloudflared`) as the transport. Access asks for a browser login
# on first use and caches it for the session.
Host smortress ssh.sammohr.dev
    HostName ssh.sammohr.dev
    User smores
    IdentityFile ~/.ssh/id_smortress-access
    IdentitiesOnly yes
    ProxyCommand cloudflared access ssh --hostname %h
    StrictHostKeyChecking accept-new

Host *
    # SSH_AUTH_SOCK is the 1Password agent; offer its keys only where a host
    # names one, never to every server.
    IdentitiesOnly yes
    Compression no
    ServerAliveInterval 0
    ServerAliveCountMax 3
    HashKnownHosts no
    UserKnownHostsFile ~/.config/ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
