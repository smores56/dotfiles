Include ~/.ssh/smortress.conf

# The work Mac has no system tailscaled: an unprivileged one runs from a
# LaunchAgent in userspace-networking mode, and its socket is where the CLI
# looks. This block cannot sit under the Include line above: an Include after a
# Host line only applies to that host.
Host smortress
    ProxyCommand $HOME/.local/share/mise/shims/tailscale --socket=$HOME/.local/state/tailscale/tailscaled.sock nc %h %p

Host *
    # Offer a key only where a host names one, never to every server.
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
