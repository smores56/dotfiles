# Copy this file to local.env (git-ignored) and fill in the values.
# It is plain shell assignments: install.sh sources it before linking.
# Never commit local.env: it carries the machine's identity, not secrets.

# personal | work. Chooses the fallback identity for checkouts that match no
# includeIf rule below. Work checkouts always use work.inc regardless.
PROFILE=personal

GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"
GIT_SIGNING_KEY="~/.ssh/id_ed25519.pub"

# GitHub owner whose checkouts under REPOS_ROOT are personal.
PERSONAL_OWNER="smores56"
REPOS_ROOT="~/repos"

# Work identity. Leave WORK_OWNERS empty on a personal-only machine; each
# owner listed here gets its own includeIf rule pointing at work.inc. WORK_EMAIL
# is required as soon as WORK_OWNERS or WORK_FLAT_ROOT is set: work.inc then
# exists, and it must not carry an empty email or signing key.
WORK_EMAIL=""
WORK_SIGNING_KEY="~/.ssh/id_ed25519.pub"
WORK_OWNERS=""
# The employer's flat checkout root (<dir>/<repo>), when one is used.
WORK_FLAT_ROOT=""
