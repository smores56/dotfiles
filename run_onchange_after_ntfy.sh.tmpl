#!/bin/sh
# Managed by chezmoi. Start the ntfy subscriber once a reader token exists.
# Failure is non-fatal: a machine without a login session (or a token) keeps
# the files and the operator can start the unit/agent after provisioning.
set -u

[ -r "$HOME/.config/ntfy/token" ] || exit 0

case $(uname -s) in
    Linux)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user daemon-reload 2>/dev/null || true
            systemctl --user enable ntfy-subscribe.service 2>/dev/null || true
            systemctl --user restart ntfy-subscribe.service 2>/dev/null || true
        fi
        ;;
    Darwin)
        plist="$HOME/Library/LaunchAgents/dev.sammohr.ntfy-subscribe.plist"
        [ -f "$plist" ] || exit 0
        launchctl unload "$plist" 2>/dev/null || true
        launchctl load -w "$plist" 2>/dev/null || true
        ;;
esac
