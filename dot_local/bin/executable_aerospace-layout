#!/bin/sh
# Rebuild the pinned AeroSpace layout from ~/.config/aerospace/layout.json.
# Invoked from ~/.aerospace.toml; AeroSpace discards output, so a failure is
# only visible when run by hand.
set -eu
config=${XDG_CONFIG_HOME:-$HOME/.config}/aerospace
export AEROSPACE_LAYOUT_SPEC="$config/layout.json"
export AEROSPACE_BIN="${AEROSPACE_BIN:-/opt/homebrew/bin/aerospace}"
python=${AEROSPACE_PYTHON:-/opt/homebrew/bin/python3}
[ -x "$python" ] || python=/usr/bin/python3
exec "$python" -I "$config/aerospace_layout.py" "$@"
