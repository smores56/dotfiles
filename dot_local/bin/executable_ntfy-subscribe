#!/bin/sh
# Desktop subscriber for the cluster's ntfy bus (topics `alerts` and `agent`).
# The token is never in this repository or in a unit file: put the reader
# token in ~/.config/ntfy/token (mode 600), then enable the unit/agent.
set -eu

token_file=${NTFY_TOKEN_FILE:-$HOME/.config/ntfy/token}
if [ ! -r "$token_file" ]; then
    printf 'ntfy-subscribe: cannot read %s\n' "$token_file" >&2
    exit 1
fi
NTFY_TOKEN=$(tr -d '[:space:]' <"$token_file")
export NTFY_TOKEN

config=${XDG_CONFIG_HOME:-$HOME/.config}/ntfy/client.yml
exec ntfy subscribe --config "$config" --from-config
