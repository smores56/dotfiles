#!/bin/sh
# repos: one checkout root for every repository, ghq-style.
#
# Layout: $REPOS_ROOT/<host>/<owner>/<repo> is the repository directory. The
# bare gitdir sits at <repo>/.git and the default branch is checked out at
# <repo>/<default-branch>; extra worktrees live under <repo>/.worktrees (see
# the `worktrees` wrapper). Work owners may instead use an employer's flat
# <WORK_FLAT>/<repo> layout while they are migrated (see `git config
# smores.workFlat` / `smores.workOwners`). A plain clone produced by an older
# ghq still lists and fetches fine — the layout is detected by git itself.
#
# Needs: git. ghq is optional; when it offers --clean-bare it does the clone.
set -u

ROOT=${REPOS_ROOT:-$HOME/ghq}
DEFAULT_HOST=github.com
WORK_FLAT=${REPOS_WORK_FLAT:-$(git config --global --get smores.workFlat 2>/dev/null || true)}
# git config keeps `~/` literal; the shell will not expand it inside quotes.
case $WORK_FLAT in
    \~/*) WORK_FLAT="$HOME/${WORK_FLAT#\~/}" ;;
esac
WORK_OWNERS=${REPOS_WORK_OWNERS:-$(git config --global --get smores.workOwners 2>/dev/null || true)}

usage() {
    cat <<'EOF'
usage: repos [list]
       repos get <owner/repo | host/owner/repo | git-url>

  list          print the directory of every repository under the root
  get <ref>     clone one repository into the root, check out its default
                branch, and print the checkout path

environment:
  REPOS_ROOT        checkout root (default: ~/ghq)
  REPOS_WORK_FLAT   flat work root (default: git config smores.workFlat)
  REPOS_WORK_OWNERS work owners (default: git config smores.workOwners)
EOF
}

die() { printf 'repos: %s\n' "$*" >&2; exit 1; }

is_git_dir() { [ -d "$1/.git" ] || [ -f "$1/.git" ]; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

is_work_owner() {
    local want owner
    want=$(lower "$1")
    # shellcheck disable=SC2086 # owners are a space-separated list of plain names
    for owner in $WORK_OWNERS; do
        [ "$(lower "$owner")" = "$want" ] && return 0
    done
    return 1
}

# One path segment: no separators, no option-looking leading dash, and no `..`
# that could walk out of the checkout root.
plain_segment() {
    case $1 in
        ''|-*|.|..|*..*|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    return 0
}

# A host only ever appears inside a directory name and a git URL, so it gets
# the same treatment: single segment, no leading dash, no `..`.
plain_host() {
    case $1 in
        ''|-*|.|*..*|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    return 0
}

# A linked worktree also carries a .git entry. Only repository directories are
# listed, so anything nested inside another repository is skipped.
nested_in_repo() {
    local dir="$1" parent
    while :; do
        parent=$(dirname "$dir")
        [ "$parent" = "$dir" ] && return 1
        [ "$parent" = "$ROOT" ] && return 1
        is_git_dir "$parent" && return 0
        dir=$parent
    done
}

list_repos() {
    local host_dir owner_dir repo_dir repo_path
    {
        for host_dir in "$ROOT"/*; do
            [ -d "$host_dir" ] || continue
            for owner_dir in "$host_dir"/*; do
                [ -d "$owner_dir" ] || continue
                for repo_dir in "$owner_dir"/*; do
                    [ -d "$repo_dir" ] || continue
                    is_git_dir "$repo_dir" || continue
                    nested_in_repo "$repo_dir" && continue
                    printf '%s\n' "$repo_dir"
                done
            done
        done
        if [ -n "$WORK_FLAT" ] && [ -d "$WORK_FLAT" ]; then
            for repo_path in "$WORK_FLAT"/*; do
                [ -d "$repo_path" ] || continue
                is_git_dir "$repo_path" || continue
                printf '%s\n' "$repo_path"
            done
        fi
    } | sort -u
}

# Prints "host owner repo" for an owner/repo shorthand, host/owner/repo, or a
# git URL. Spaces never appear in any of the three fields.
parse_ref() {
    local input="$1" host rest owner repo
    case $input in
        git@*:*)
            host=${input#git@}; host=${host%%:*}; rest=${input#*:} ;;
        ssh://git@*/*)
            host=${input#ssh://git@}; host=${host%%/*}; rest=${input#ssh://git@*/} ;;
        https://*/*/*|http://*/*/*)
            rest=${input#*://}; host=${rest%%/*}; rest=${rest#*/} ;;
        */*/*)
            host=${input%%/*}; rest=${input#*/} ;;
        */*)
            host=$DEFAULT_HOST; rest=$input ;;
        *)
            return 1 ;;
    esac
    rest=${rest%.git}
    case $rest in */*/*) return 1 ;; esac
    owner=${rest%%/*}
    repo=${rest#*/}
    [ -n "$host" ] && plain_host "$host" || return 1
    [ -n "$owner" ] && plain_segment "$owner" || return 1
    [ "$repo" != "$rest" ] || return 1
    plain_segment "$repo" || return 1
    printf '%s %s %s\n' "$host" "$owner" "$repo"
}

# A bare clone keeps every branch in refs/heads, and fetch refuses to update a
# branch a worktree has checked out. Track remote branches instead so `git
# fetch` stays safe once worktrees exist, and record the upstream of every
# branch so a checkout of any of them can `git pull` without a first push.
track_remote_branches() {
    local gitdir="$1" branch ref
    branch=$(git --git-dir="$gitdir" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
    git --git-dir="$gitdir" for-each-ref --format='%(refname:short)' refs/heads \
        | while IFS= read -r ref; do
            [ -n "$ref" ] || continue
            git --git-dir="$gitdir" update-ref "refs/remotes/origin/$ref" "refs/heads/$ref"
            git --git-dir="$gitdir" config "branch.$ref.remote" origin
            git --git-dir="$gitdir" config "branch.$ref.merge" "refs/heads/$ref"
        done
    if [ -n "$branch" ]; then
        git --git-dir="$gitdir" symbolic-ref "refs/remotes/origin/HEAD" "refs/remotes/origin/$branch"
    fi
    git --git-dir="$gitdir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
}

# A bare checkout has no working tree; check out the default branch next to the
# gitdir and print that path.
checkout_default() {
    local gitdir="$1" dest="$2" branch
    branch=$(git --git-dir="$gitdir" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
    [ -n "$branch" ] || return 1
    git --git-dir="$gitdir" worktree add "$dest/$branch" "$branch" >/dev/null || return 1
    printf '%s\n' "$dest/$branch"
}

ghq_supports_clean_bare() {
    command -v ghq >/dev/null 2>&1 || return 1
    ghq get --help 2>&1 | grep -q -- '--clean-bare'
}

# Removes whatever a failed clone left behind, so a retry starts from nothing
# instead of tripping the "already exists" guard.
cleanup_failed_get() {
    rm -rf "${1:?}"
    rmdir "$(dirname "$1")" 2>/dev/null || true
}

# GitHub names are case-insensitive; a flat root can only hold one spelling.
check_work_destination() {
    local repo="$1" candidate name
    [ -d "$WORK_FLAT" ] || return 0
    for candidate in "$WORK_FLAT"/*; do
        [ -e "$candidate" ] || [ -L "$candidate" ] || continue
        name=${candidate##*/}
        if [ "$name" != "$repo" ] && [ "$(lower "$name")" = "$(lower "$repo")" ]; then
            printf 'repos get: %s conflicts with %s (GitHub names are case-insensitive)\n' \
                "$WORK_FLAT/$repo" "$candidate" >&2
            return 1
        fi
    done
}

get_repo() {
    local input="$1" ref host owner repo dest url checkout

    [ $# -eq 1 ] || { usage >&2; exit 2; }
    ref=$(parse_ref "$input") || die "expected owner/repo, host/owner/repo, or a git URL: $input"
    # shellcheck disable=SC2086 # fields are single tokens and contain no spaces
    set -- $ref
    host=$1 owner=$2 repo=$3

    dest=$ROOT/$host/$owner/$repo
    if [ "$host" = "$DEFAULT_HOST" ] && [ -n "$WORK_FLAT" ] && is_work_owner "$owner"; then
        dest=$WORK_FLAT/$repo
        check_work_destination "$repo" || exit 1
    fi
    if [ -e "$dest" ] || [ -L "$dest" ]; then
        die "destination already exists: $dest"
    fi

    if [ "$dest" = "$WORK_FLAT/$repo" ]; then
        mkdir -p "$WORK_FLAT"
    else
        mkdir -p "$ROOT/$host/$owner"
    fi
    url="git@$host:$owner/$repo.git"

    # A failed clone leaves no half-populated checkout: ghq and git both create
    # the destination before they can fail, so remove it the same way. The flat
    # work layout is not a ghq layout, so it always uses a bare clone.
    if [ "$dest" = "$ROOT/$host/$owner/$repo" ] && ghq_supports_clean_bare; then
        if ! GHQ_ROOT=$ROOT ghq get --clean-bare -p "$host/$owner/$repo" >&2; then
            cleanup_failed_get "$dest"
            die "ghq get failed: $host/$owner/$repo"
        fi
        checkout=$(checkout_default "$dest/.git" "$dest") || checkout=""
        track_remote_branches "$dest/.git"
    else
        if ! git clone --bare "$url" "$dest/.git"; then
            cleanup_failed_get "$dest"
            die "clone failed: $url"
        fi
        checkout=$(checkout_default "$dest/.git" "$dest") || checkout=""
        track_remote_branches "$dest/.git"
    fi

    if [ -n "$checkout" ]; then
        printf '%s\n' "$checkout"
    else
        printf '%s\n' "$dest"
    fi
}

case ${1-} in
    ""|list|ls) list_repos ;;
    get) shift; get_repo "$@" ;;
    -h|--help|help) usage ;;
    *) printf 'repos: unknown command: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
