#!/bin/sh
# worktrees: list, create, and prune the worktrees of the current repository.
#
# Worktrees live under <repo>/.worktrees/, where <repo> is the directory that
# holds the git common dir. That layout is identical for a plain clone and for
# a ghq --clean-bare checkout whose bare gitdir sits at <repo>/.git.
#
# Branch names come from `git config smores.branchTemplate` (default
# smores/{slug}), so branch naming stays a repository decision.
set -u

DEFAULT_TEMPLATE='smores/{slug}'
# There is no default unticketed template: a repository whose template needs
# {ticket} decides whether an unticketed branch is allowed by setting
# smores.branchTemplateUnticketed. Without it, --ticket is required.

usage() {
    cat <<'EOF'
usage: worktrees [list]
       worktrees new --slug <slug> [--task <text>] [--ticket <KEY>]
                     [--type <type>] [--base <ref>] [--dry-run]
       worktrees prune [--dry-run] [--min-age <0s|Nm|Nh|Nd>]

  list    print the path of every worktree; the bare gitdir is skipped
  new     create <repo>/.worktrees/<branch with / replaced by -> and print
          JSON: {"branch":...,"path":...,"ticket":...,"base":...}
  prune   remove worktrees (and merged branches) whose commits are already in
          the default branch

branch template:
  smores.branchTemplate            e.g. smores/{slug} or {type}/{ticket}-{slug}
  smores.branchTemplateUnticketed  set it to allow branches without a ticket;
                                   leave it unset to require --ticket
EOF
}

die() {
    printf '%s\n' "$1" >&2
    exit "${2:-1}"
}

# Prints a JSON string literal. Paths and branch names never contain newlines.
json_string() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/^/"/' -e 's/$/"/'
}

# Keeps branch paths readable: lowercase, [a-z0-9-] only, at most 50 chars.
slugify() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' \
        | cut -c1-50 \
        | sed -e 's/-*$//'
}

repo_root() {
    local common
    common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
    case $common in
        /*) ;;
        *) common=$(pwd)/$common ;;
    esac
    common=$(cd "$common" 2>/dev/null && pwd -P) || return 1
    dirname "$common"
}

list_worktrees() {
    git worktree list --porcelain | awk '
        /^worktree / { if (path != "" && !bare) print path; path = substr($0, 10); bare = 0; next }
        /^bare$/     { bare = 1; next }
        END          { if (path != "" && !bare) print path }
    '
}

main_worktree() {
    git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }'
}

current_worktree() {
    git rev-parse --show-toplevel 2>/dev/null || true
}

worktree_branch() {
    git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

ref_sha() {
    git rev-parse --verify --quiet "$1^{commit}" 2>/dev/null || true
}

# The default branch as origin sees it, falling back to the usual names and
# then to whatever HEAD points at.
default_ref() {
    local ref
    ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || ref=""
    if [ -n "$ref" ]; then printf '%s\n' "$ref"; return 0; fi
    if git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null; then printf 'origin/main\n'; return 0; fi
    if git rev-parse --verify --quiet refs/remotes/origin/master >/dev/null; then printf 'origin/master\n'; return 0; fi
    if git rev-parse --verify --quiet refs/heads/main >/dev/null; then printf 'main\n'; return 0; fi
    if git rev-parse --verify --quiet refs/heads/master >/dev/null; then printf 'master\n'; return 0; fi
    printf 'HEAD\n'
}

render_branch() {
    local out="$1"
    out=$(printf '%s' "$out" | sed -e "s|{ticket}|$2|g" -e "s|{type}|$3|g" -e "s|{slug}|$4|g")
    case $out in
        *'{'*|*'}'*) die "worktrees new: unknown placeholder in branch template: $1" 2 ;;
    esac
    printf '%s\n' "$out"
}

ticket_json() {
    if [ -n "$1" ]; then json_string "$1"; else printf 'null'; fi
}

create_new() {
    local slug="" task="" ticket="" type="" base="" dry_run=false
    local template unticketed lowered branch name root path default

    while [ $# -gt 0 ]; do
        case $1 in
            --slug|--task|--ticket|--type|--base)
                [ $# -ge 2 ] || die "worktrees new: $1 needs a value" 2
                case $1 in
                    --slug) slug=$2 ;;
                    --task) task=$2 ;;
                    --ticket) ticket=$2 ;;
                    --type) type=$2 ;;
                    --base) base=$2 ;;
                esac
                shift 2 ;;
            --dry-run) dry_run=true; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "worktrees new: unknown arg: $1" 2 ;;
        esac
    done

    [ -n "$slug" ] || {
        [ -n "$task" ] || die "worktrees new: --slug or --task required" 2
        slug=$task
    }

    git rev-parse --git-dir >/dev/null 2>&1 || die "worktrees new: not inside a git repository"

    template=$(git config --get smores.branchTemplate 2>/dev/null) || template=""
    unticketed=$(git config --get smores.branchTemplateUnticketed 2>/dev/null) || unticketed=""
    [ -n "$template" ] || template=$DEFAULT_TEMPLATE

    case $template in
        *'{ticket}'*)
            if [ -n "$ticket" ]; then
                # case patterns, not grep: a value with a newline must be rejected
                case $ticket in
                    *[!A-Z0-9-]*|[!A-Z]*) die "worktrees new: --ticket must be a ticket key like ABC-123: $ticket" 2 ;;
                esac
                case $ticket in
                    *-[0-9]*) ;;
                    *) die "worktrees new: --ticket must be a ticket key like ABC-123: $ticket" 2 ;;
                esac
            elif [ -n "$unticketed" ]; then
                template=$unticketed
            fi ;;
        *)
            if [ -n "$ticket" ]; then
                printf 'worktrees new: template %s has no {ticket}; ignoring --ticket %s\n' "$template" "$ticket" >&2
                ticket=""
            fi ;;
    esac
    if [ -z "$ticket" ]; then
        case $template in
            *'{ticket}'*) die "worktrees new: this repository needs --ticket (template $template)" 2 ;;
        esac
    fi

    case $template in
        *'{type}'*)
            [ -n "$type" ] || die "worktrees new: this repository needs --type (template $template)" 2
            case $type in
                *[!a-z0-9-]*|[!a-z]*) die "worktrees new: --type must be lowercase kebab: $type" 2 ;;
            esac ;;
    esac

    slug=$(slugify "$slug")
    if [ -n "$ticket" ]; then
        lowered=$(slugify "$ticket")
        if [ "$slug" = "$lowered" ]; then slug=""; else slug=${slug#"$lowered"-}; fi
    fi
    [ -n "$slug" ] || die "worktrees new: empty slug" 2

    branch=$(render_branch "$template" "$ticket" "$type" "$slug")
    git check-ref-format --branch "$branch" >/dev/null 2>&1 \
        || die "worktrees new: invalid branch name: $branch" 2
    name=$(printf '%s' "$branch" | tr '/' '-')

    root=$(repo_root) || die "worktrees new: could not resolve the repository root"
    path=$root/.worktrees/$name

    if [ -z "$base" ]; then
        git fetch --prune origin >/dev/null 2>&1 \
            || printf 'worktrees new: fetch failed; using local refs\n' >&2
        default=$(default_ref)
        base=$default
    fi

    if $dry_run; then
        printf '{"branch":%s,"path":%s,"ticket":%s,"base":%s,"dry_run":true}\n' \
            "$(json_string "$branch")" "$(json_string "$path")" \
            "$(ticket_json "$ticket")" "$(json_string "$base")"
        exit 0
    fi

    git show-ref --verify --quiet "refs/heads/$branch" \
        && die "worktrees new: branch already exists: $branch"
    [ ! -e "$path" ] || die "worktrees new: path already exists: $path"
    mkdir -p "$root/.worktrees"
    git worktree add "$path" -b "$branch" "$base" >/dev/null \
        || die "worktrees new: could not add worktree for $branch"
    printf '{"branch":%s,"path":%s,"ticket":%s,"base":%s}\n' \
        "$(json_string "$branch")" "$(json_string "$path")" \
        "$(ticket_json "$ticket")" "$(json_string "$base")"
}

# Prints why a branch is already contained in the target, or nothing when it
# still holds work of its own.
integrated_reason() {
    local branch="$1" target="$2" branch_sha target_sha merge_base diff merged_tree target_tree
    branch_sha=$(ref_sha "$branch")
    target_sha=$(ref_sha "$target")
    [ -n "$branch_sha" ] && [ -n "$target_sha" ] || return 1
    if [ "$branch_sha" = "$target_sha" ]; then printf 'same-commit\n'; return 0; fi
    if git merge-base --is-ancestor "$branch" "$target" 2>/dev/null; then
        printf 'ancestor\n'; return 0
    fi
    merge_base=$(git merge-base "$target" "$branch" 2>/dev/null) || merge_base=""
    if [ -n "$merge_base" ]; then
        diff=$(git diff --name-only "$merge_base..$branch" 2>/dev/null) || diff="x"
        if [ -z "$diff" ]; then printf 'no-added-changes\n'; return 0; fi
    fi
    merged_tree=$(git merge-tree --write-tree "$target" "$branch" 2>/dev/null) || return 1
    target_tree=$(git rev-parse "$target^{tree}" 2>/dev/null) || return 1
    if [ "$merged_tree" = "$target_tree" ]; then printf 'content-integrated\n'; return 0; fi
    return 1
}

delete_flag_for() {
    case $1 in
        ancestor|same-commit|no-added-changes) printf '%s\n' -d ;;
        *) printf '%s\n' -D ;;
    esac
}

duration_seconds() {
    local value
    case $1 in
        0s) printf '0\n'; return 0 ;;
    esac
    case $1 in
        *s|*m|*h|*d) : ;;
        *) die "worktrees prune: invalid --min-age: $1" 2 ;;
    esac
    value=${1%?}
    printf '%s' "$value" | grep -Eq '^[0-9]+$' \
        || die "worktrees prune: invalid --min-age: $1" 2
    case $1 in
        *s) printf '%s\n' "$value" ;;
        *m) printf '%s\n' $(( value * 60 )) ;;
        *h) printf '%s\n' $(( value * 3600 )) ;;
        *d) printf '%s\n' $(( value * 86400 )) ;;
    esac
}

worktree_age_seconds() {
    local path="$1" git_dir meta
    git_dir=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null) || return 1
    meta=$git_dir
    [ -f "$git_dir/commondir" ] && meta=$git_dir/$(cat "$git_dir/commondir" 2>/dev/null)
    stat -c '%Y' "$meta" 2>/dev/null || stat -f '%m' "$meta" 2>/dev/null || return 1
}

branch_age_seconds() {
    git reflog show --format='%ct' "refs/heads/$1" 2>/dev/null | tail -1
}

prune_worktrees() {
    local dry_run=false min_age=0s
    local min_age_secs now current main target target_branch
    local path branch reason delete_flag age created
    local checked_out orphan

    while [ $# -gt 0 ]; do
        case $1 in
            --dry-run) dry_run=true; shift ;;
            --min-age) [ $# -ge 2 ] || die "worktrees prune: --min-age needs a value" 2; min_age=$2; shift 2 ;;
            --min-age=*) min_age=${1#--min-age=}; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "worktrees prune: unknown arg: $1" 2 ;;
        esac
    done

    git rev-parse --git-dir >/dev/null 2>&1 || die "worktrees prune: not inside a git repository"
    min_age_secs=$(duration_seconds "$min_age") || exit 2
    now=$(date +%s)
    current=$(current_worktree)
    main=$(main_worktree)
    target=$(default_ref)
    target_branch=${target#origin/}

    git fetch --prune origin >/dev/null 2>&1 || printf 'worktrees prune: fetch failed; using local refs\n' >&2

    list_worktrees | while IFS= read -r path; do
        [ "$path" != "$main" ] || continue
        branch=$(worktree_branch "$path")
        [ -n "$branch" ] || continue
        [ "$branch" != "$target_branch" ] || continue
        reason=$(integrated_reason "$branch" "$target") || reason=""
        [ -n "$reason" ] || continue
        if [ "$min_age_secs" -gt 0 ]; then
            created=$(worktree_age_seconds "$path" 2>/dev/null) || continue
            age=$(( now - created ))
            if [ "$age" -lt "$min_age_secs" ]; then
                printf 'worktrees prune: skip %s branch %s (younger than %s)\n' "$path" "$branch" "$min_age" >&2
                continue
            fi
        fi
        if $dry_run; then
            printf 'would-remove %s branch %s reason %s\n' "$path" "$branch" "$reason"
            continue
        fi
        if [ "$path" = "$current" ]; then
            printf 'worktrees prune: skip %s branch %s (current worktree)\n' "$path" "$branch" >&2
            continue
        fi
        if git worktree remove "$path" 2>/dev/null; then
            printf 'remove %s branch %s reason %s\n' "$path" "$branch" "$reason"
            delete_flag=$(delete_flag_for "$reason")
            git branch "$delete_flag" "$branch" >/dev/null 2>&1 || true
        else
            printf 'worktrees prune: skip %s branch %s (dirty or locked)\n' "$path" "$branch" >&2
        fi
    done

    # Branches whose worktree is already gone but whose commits are merged.
    checked_out=$(list_worktrees | while IFS= read -r path; do worktree_branch "$path"; done)
    for orphan in $(git for-each-ref --format='%(refname:short)' refs/heads); do
        [ "$orphan" != "$target_branch" ] || continue
        printf '%s\n' "$checked_out" | grep -qx "$orphan" && continue
        reason=$(integrated_reason "$orphan" "$target") || reason=""
        [ -n "$reason" ] || continue
        if [ "$min_age_secs" -gt 0 ]; then
            created=$(branch_age_seconds "$orphan") || created=""
            [ -n "$created" ] || continue
            age=$(( now - created ))
            if [ "$age" -lt "$min_age_secs" ]; then
                printf 'worktrees prune: skip branch %s (younger than %s)\n' "$orphan" "$min_age" >&2
                continue
            fi
        fi
        if $dry_run; then
            printf 'would-remove branch-only %s reason %s\n' "$orphan" "$reason"
            continue
        fi
        printf 'remove branch-only %s reason %s\n' "$orphan" "$reason"
        delete_flag=$(delete_flag_for "$reason")
        git branch "$delete_flag" "$orphan" >/dev/null 2>&1 || true
    done

    if ! $dry_run; then git worktree prune; fi
}

case ${1-} in
    ""|list|ls) list_worktrees ;;
    new|n) shift; create_new "$@" ;;
    prune|p) shift; prune_worktrees "$@" ;;
    -h|--help|help) usage ;;
    *) printf 'worktrees: unknown command: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
