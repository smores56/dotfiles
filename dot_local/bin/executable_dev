#!/bin/sh
# dev: run the current repository inside its development container.
#
# The repository's own Containerfile is the canonical development contract;
# when a repository has none, the shared image in ~/.config/containers is used
# so a fresh checkout still gets a usable shell. Podman is preferred, Docker
# works the same way, and no engine socket is ever mounted: build and test
# containers are not privileged children of the host daemon.
#
# Credentials never cross the boundary: ~/.ssh is not mounted and no token is
# passed in. The SSH agent socket is forwarded, so signing and fetch work while
# the private keys stay on the host; git configuration is mounted read-only.
set -eu

usage() {
    cat <<'EOF'
usage: dev [--build] [--engine podman|docker] [--] [command ...]

  --build     rebuild the image from the repository's Containerfile first
  --engine    container engine to use (default: $DEV_ENGINE, else podman,
              else docker)
  command     command to run instead of the image's default command

environment:
  DEV_ENGINE  container engine override
  DEV_IMAGE   image tag override (default: dev-<repository>:local)
EOF
}

msg() { printf 'dev: %s\n' "$*" >&2; }
die() { msg "$1"; exit 1; }

build_only=false
engine=""
while [ $# -gt 0 ]; do
    case $1 in
        --build|-b) build_only=true; shift ;;
        --engine) [ $# -ge 2 ] || die "--engine needs a value"; engine=$2; shift 2 ;;
        --engine=*) engine=${1#*=}; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
# Everything left in "$@" is the command to run inside the container.

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"

if [ -z "$engine" ]; then
    if [ -n "${DEV_ENGINE:-}" ]; then
        engine=$DEV_ENGINE
    elif command -v podman >/dev/null 2>&1; then
        engine=podman
    elif command -v docker >/dev/null 2>&1; then
        engine=docker
    else
        die "neither podman nor docker is installed"
    fi
fi
command -v "$engine" >/dev/null 2>&1 || die "engine not found: $engine"

# Repositories get their own image tag so two projects cannot silently share a
# build. A repository that wants the shared one sets DEV_IMAGE.
repo_name=$(basename "$root" | tr '[:upper:]' '[:lower:]')
image=${DEV_IMAGE:-dev-$repo_name:local}

containerfile=""
context=""
for candidate in "$root/Containerfile" "$root/Containerfile.dev" "$root/containers/Containerfile"; do
    if [ -f "$candidate" ]; then
        containerfile=$candidate
        context=$root
        break
    fi
done
if [ -z "$containerfile" ]; then
    config_home=${XDG_CONFIG_HOME:-$HOME/.config}
    containerfile=$config_home/containers/Containerfile.dev
    context=$config_home/containers
    [ -f "$containerfile" ] || die "no Containerfile for $root and no $containerfile"
fi

if $build_only || ! "$engine" image inspect "$image" >/dev/null 2>&1; then
    msg "building $image from $containerfile"
    "$engine" build -t "$image" -f "$containerfile" "$context"
    if $build_only; then exit 0; fi
fi

# Build the run command as a properly single-quoted string. Positional
# parameters cannot be prepended in POSIX sh, and the command to run lives
# there, so the prefix is assembled textually and expanded once.
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

run_args=" run --rm"
# Interactive only when a terminal is attached: a piped or CI invocation must
# not allocate a TTY, or the container blocks waiting for input that never
# arrives.
if [ -t 0 ]; then run_args="$run_args -i"; fi
if [ -t 1 ]; then run_args="$run_args -t"; fi
append() { run_args="$run_args $(quote "$1")"; }
append_literal() { run_args="$run_args $1"; }

append --workdir; append "$root"
append --hostname; append dev
append --env; append HOME=/home/dev
append --env; append "TERM=${TERM:-xterm-256color}"

# SELinux relabelling is what makes the mount usable on Fedora Atomic; Docker
# and macOS ignore the :Z suffix, so only ask podman on Linux.
if [ "$engine" = podman ] && [ "$(uname -s)" = Linux ]; then
    selinux=true
    append_literal --userns=keep-id:uid=1000,gid=1000
    append --volume; append "$root:$root:Z"
else
    selinux=false
    append --user; append "$(id -u):$(id -g)"
    append --volume; append "$root:$root"
fi
if $selinux; then ro_opts=ro,Z; rw_opts=Z; else ro_opts=ro; rw_opts=""; fi

# Git identity and configuration are mounted read-only: the container needs
# the settings, not the credentials. ~/.ssh is deliberately absent, and
# GH_TOKEN/GITHUB_TOKEN are deliberately not forwarded — a container that can
# read a token can push anywhere that token reaches.
if [ -f "$HOME/.gitconfig" ]; then
    append --volume; append "$HOME/.gitconfig:/home/dev/.gitconfig:$ro_opts"
fi
git_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/git
if [ -d "$git_config_dir" ]; then
    append --volume; append "$git_config_dir:/home/dev/.config/git:$ro_opts"
fi

# The agent socket is the only cryptographic access the container gets: it can
# sign and fetch, it cannot read or copy the key.
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    append --volume; append "$SSH_AUTH_SOCK:$SSH_AUTH_SOCK"
    append --env; append "SSH_AUTH_SOCK=$SSH_AUTH_SOCK"
fi

# Tool installs are per repository. A shared volume would put one checkout's
# mise shims and binaries on another checkout's PATH, and either container
# could rewrite the other's tools. The trusted config path is the checkout
# itself, never a parent or /.
repo_slug=$(printf '%s' "$repo_name" | tr -c 'a-z0-9_.-' '-')
volume_name=dev-mise-$repo_slug-$(printf '%s' "$root" | cksum | cut -d ' ' -f 1)
append --volume; append "$volume_name:/home/dev/.local/share/mise"
append --env; append "MISE_TRUSTED_CONFIG_PATHS=$root"

# A gitdir outside the checkout (the clean-bare root, when working inside a
# branch worktree) must be visible at the same path inside the container, and
# git writes to it, so it is mounted read-write with the SELinux label.
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [ -n "$common_dir" ]; then
    case $common_dir in
        "$root"/*) ;;
        *) append --volume; append "$common_dir:$common_dir${rw_opts:+:$rw_opts}" ;;
    esac
fi

append_literal "$(quote "$image")"
# With no command the image's own CMD runs. No probe container: asking the
# engine whether fish exists starts a second container on every invocation.

eval "set -- $(quote "$engine") $run_args \"\$@\""
exec "$@"
