# Managed file: ~/.ssh/config, linked from this checkout by mise.
#
# One multiplexed transport per destination, known hosts under ~/.config/ssh,
# and no agent or key invention. GitHub is reached over https, never ssh.

# smortress only accepts this key as `smores`; its firewall drops LAN SSH, so
# the tailnet name is the route and the key must be named here to be offered.
Host smortress
    HostName smortress
    User smores
    IdentityFile ~/.ssh/id_smortress-access
    IdentitiesOnly yes

Host *
    Compression no
    ServerAliveInterval 0
    ServerAliveCountMax 3
    HashKnownHosts no
    UserKnownHostsFile ~/.config/ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
