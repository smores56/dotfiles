# Managed file: ~/.ssh/config, linked from this checkout by mise.
#
# One multiplexed transport per destination, known hosts under ~/.config/ssh,
# and no agent or key invention. GitHub is reached over https, never ssh.
#
# The smortress route lives in the include: it is the same sled on every
# machine that reaches the host, so it is written once (home/.ssh/smortress.conf).
Include ~/.ssh/smortress.conf

Host *
    Compression no
    ServerAliveInterval 0
    ServerAliveCountMax 3
    HashKnownHosts no
    UserKnownHostsFile ~/.config/ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.cache/ssh-%C
    ControlPersist 10m
