# Machine identity lives in ~/.config/git/machine.inc, which each environment
# renders (mise.identity.toml with includeIf routing, mise.work.toml).
#
# The include stays last: an include is read where it appears, so a section
# below it would override the identity its conditional includes chose.
[init]
    defaultBranch = main

[core]
    pager = delta

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autosquash = true
    updateRefs = true

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true

[diff]
    algorithm = histogram
    colorMoved = default

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/ssh/allowed_signers

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

[column]
    ui = auto

[help]
    autocorrect = prompt

[credential "https://github.com"]
    helper =
    helper = !PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH" gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH" gh auth git-credential

[include]
    path = ~/.config/git/machine.inc
