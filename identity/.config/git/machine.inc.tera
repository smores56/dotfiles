# Rendered by mise from the identity vars; change one with
# `mise vars NAME=VALUE`, then `mise -C <dotfiles> dot apply`.
[user]
    name = "{{ vars.git_name }}"
    email = "{{ vars.git_email }}"
    signingkey = "{{ vars.git_signing_key }}"
[smores]
    flow = "local"
    workFlat = "{{ vars.work_flat_root }}"
    workOwners = "{{ vars.work_owners }}"

# Personal checkouts, by path and by remote URL.
[includeIf "gitdir:{{ vars.repos_root }}/github.com/{{ vars.personal_owner }}/"]
    path = ~/.config/git/personal.inc
[includeIf "hasconfig:remote.*.url:git@github.com:{{ vars.personal_owner }}/**"]
    path = ~/.config/git/personal.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/{{ vars.personal_owner }}/**"]
    path = ~/.config/git/personal.inc
[includeIf "hasconfig:remote.*.url:https://github.com/{{ vars.personal_owner }}/**"]
    path = ~/.config/git/personal.inc
{%- for owner in vars.work_owners | split(pat=" ") %}{% if owner %}

# Work checkouts for {{ owner }}.
[includeIf "gitdir:{{ vars.repos_root }}/github.com/{{ owner }}/"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:git@github.com:{{ owner }}/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/{{ owner }}/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:https://github.com/{{ owner }}/**"]
    path = ~/.config/git/work.inc
{%- endif %}{% endfor %}
{%- if vars.work_flat_root %}

# The employer flat layout (<dir>/<repo>) is work.
[includeIf "gitdir:{{ vars.work_flat_root }}/"]
    path = ~/.config/git/work.inc
{%- endif %}
