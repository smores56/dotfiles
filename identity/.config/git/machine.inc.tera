# Rendered by mise.
[user]
    name = "Sam Mohr"
    email = "sam@sammohr.dev"
[smores]
    flow = "local"

# The fetch refspec at clone time fills origin/* in the same pass. GIT_DIR is
# unset because, run from a linked worktree, git exports that worktree's
# GIT_DIR to the alias and would aim the worktree step at the caller's repo.
[alias]
    get = "!f() { unset GIT_DIR GIT_WORK_TREE; d={{ vars.repos_root }}/github.com/${1:?usage: git get owner/repo} && git clone --bare -c remote.origin.fetch='+refs/heads/*:refs/remotes/origin/*' https://github.com/$1 $d/.git && b=$(git -C $d symbolic-ref --short HEAD) && git -C $d worktree add -B $b $d/$b origin/$b; }; f"

# Work checkouts, by path and by remote URL as written (insteadOf does not apply).
[includeIf "gitdir:{{ vars.repos_root }}/github.com/blitzy-ai/"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:git@github.com:blitzy-ai/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/blitzy-ai/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:https://github.com/blitzy-ai/**"]
    path = ~/.config/git/work.inc
[includeIf "gitdir:{{ vars.repos_root }}/github.com/blitzy-platform/"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:git@github.com:blitzy-platform/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/blitzy-platform/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:https://github.com/blitzy-platform/**"]
    path = ~/.config/git/work.inc

[includeIf "gitdir:~/Blitzy/"]
    path = ~/.config/git/work.inc
