# Rendered by mise.
[user]
    name = "Sam Mohr"
    email = "sam@sammohr.dev"
[smores]
    flow = "local"

# ghq owns the personal checkout root; worktrees live beside each bare
# repository (see AGENTS.md).
[ghq]
    root = "/srv/git"

# Work checkouts, by path and by remote URL.
[includeIf "gitdir:/srv/git/github.com/blitzy-ai/"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:git@github.com:blitzy-ai/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/blitzy-ai/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:https://github.com/blitzy-ai/**"]
    path = ~/.config/git/work.inc
[includeIf "gitdir:/srv/git/github.com/blitzy-platform/"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:git@github.com:blitzy-platform/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/blitzy-platform/**"]
    path = ~/.config/git/work.inc
[includeIf "hasconfig:remote.*.url:https://github.com/blitzy-platform/**"]
    path = ~/.config/git/work.inc

# The employer flat layout (<dir>/<repo>) is work.
[includeIf "gitdir:~/Blitzy/"]
    path = ~/.config/git/work.inc
