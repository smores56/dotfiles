#!/bin/sh
# Managed by chezmoi. Rebuild ~/.config/ssh/allowed_signers from the public
# halves of the personal and work signing keys, so `git log --show-signature`
# and `git verify-commit` work on a fresh machine. Runs on every apply and is a
# no-op when no key exists yet.
set -u

email={{ .email | quote }}
work_email={{ if .work_email }}{{ .work_email | quote }}{{ else }}{{ .email | quote }}{{ end }}
personal_key={{ .personal_signing_key | quote }}
work_key={{ .work_signing_key | quote }}

expand() {
    case $1 in
        "~/"*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

out="$HOME/.config/ssh/allowed_signers"
mkdir -p "$(dirname "$out")" "$HOME/.cache" || exit 0
chmod 700 "$(dirname "$out")" 2>/dev/null || true

tmp=$(mktemp "$out.XXXXXX") || exit 1
{
    personal=$(expand "$personal_key")
    if [ -r "$personal" ]; then
        printf '%s namespaces="git" %s\n' "$email" "$(cat "$personal")"
    fi
    work=$(expand "$work_key")
    if [ -r "$work" ]; then
        printf '%s namespaces="git" %s\n' "$work_email" "$(cat "$work")"
    fi
} >"$tmp"
mv "$tmp" "$out" || { rm -f "$tmp"; exit 1; }
chmod 644 "$out" 2>/dev/null || true
