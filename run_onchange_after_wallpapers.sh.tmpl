#!/bin/sh
# Managed by chezmoi. Enable the wallpaper rotation after the files land.
# Failure is non-fatal: a headless or session-less machine keeps the files.
set -u

case $(uname -s) in
    Linux)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user daemon-reload 2>/dev/null || true
            systemctl --user enable --now wallpapers.timer 2>/dev/null || true
        fi
        ;;
    Darwin)
        plist="$HOME/Library/LaunchAgents/dev.sammohr.wallpapers.plist"
        [ -f "$plist" ] || exit 0
        launchctl unload "$plist" 2>/dev/null || true
        launchctl load -w "$plist" 2>/dev/null || true
        ;;
esac
