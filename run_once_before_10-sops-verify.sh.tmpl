#!/bin/sh
# chezmoi run_once_before: prove that the admin identity decrypts a real sops
# file through ~/.local/bin/sops-age-key, so a missing or wrong key is caught on
# the first apply instead of during an incident. A machine that has no checkout
# only skips: the first login of a fresh install must not fail for a clone that
# does not exist yet.
set -eu

file=${HOMELAB_SECRETS_FILE:-$HOME/repos/github.com/smores56/homelab-platform/secrets/660-host.yaml}

if [ ! -f "$file" ]; then
    printf 'sops verify skipped: no checkout yet (%s is absent).\n' "$file"
    exit 0
fi

# sops reads an identity from SOPS_AGE_KEY_FILE without running the wrapper, so a
# leftover export would hide a broken ~/.config/sops/keys.age.
unset SOPS_AGE_KEY_FILE
# The login shell sets SOPS_AGE_KEY_CMD; the fallback keeps this check honest on
# a machine whose shell config has not been applied yet.
if [ -z "${SOPS_AGE_KEY_CMD:-}" ]; then
    SOPS_AGE_KEY_CMD=$HOME/.local/bin/sops-age-key
    export SOPS_AGE_KEY_CMD
fi

if sops -d "$file" >/dev/null; then
    printf 'sops verify ok: %s decrypted.\n' "$file"
else
    printf 'sops verify failed: %s did not decrypt; check ~/.config/sops/keys.age.\n' "$file" >&2
    exit 1
fi
