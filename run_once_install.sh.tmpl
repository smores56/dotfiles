#!/bin/sh
# chezmoi run_once: machine bootstrap, executed once per machine after the
# managed files are applied. Idempotent: every step first checks whether the
# work is already done, so a re-run after a partial failure is safe.
#
# It uses the network (package manager, mise) but never stores or prints a
# secret. The shell works before this runs; this only adds packages.
set -u

PROFILE={{ .profile | quote }}
IS_HEADLESS={{ .is_headless }}

# The mise release this file is allowed to fetch. The sha256 values below are
# that release.s published checksums. Keep them in step with
# dot_config/containers/Containerfile.dev and dot_config/mise/config.toml.
MISE_VERSION=v2026.11.8

printf 'Bootstrapping the %s profile.\n' "$PROFILE"

print_followups() {
    cat <<'EOF'

Manual follow-ups, once per machine:
  1. GitHub access
       gh auth login --git-protocol ssh
       ssh-keygen -t ed25519 -C "$(hostname)"    # skip if the key exists
       gh ssh-key add ~/.ssh/id_ed25519.pub -t "$(hostname)"
  2. Tool versions
       mise install
       rustup toolchain install stable   # macOS: dot_cargo expects stable
       mise ls
  3. Verify the dotfiles
       chezmoi diff
  4. Verify the checkout layout
       repos list
       worktrees list
  5. macOS GUI casks (macOS only)
       brew bundle --file ~/.config/homebrew/Brewfile
  6. ntfy notifications (optional)
       mkdir -p ~/.config/ntfy
       printf '%s\n' '<reader-token>' > ~/.config/ntfy/token
       chmod 600 ~/.config/ntfy/token
       chezmoi apply
EOF
}

{{ $os := get . "os" | default .chezmoi.os -}}
{{ if eq $os "linux" -}}
# ---------------------------------------------------------------- Fedora Atomic
if command -v rpm-ostree >/dev/null 2>&1; then
    OSTREE=1
else
    OSTREE=0
fi

# rpm-ostree layers need a reboot; dnf is used on non-atomic Fedora only.
# zellij, yazi, television, ghq, zoxide, and delta have no Fedora package;
# mise installs them (see dot_config/mise/config.toml). The Nerd font is the
# packaged Caskaydia Mono NF.
PACKAGES="fish zsh gh git git-lfs just jq yq ripgrep fd-find bat eza shellcheck podman flatpak rsync helix lazygit cascadia-mono-nf-fonts"
missing=""
for pkg in $PACKAGES; do
    rpm -q "$pkg" >/dev/null 2>&1 || missing="$missing $pkg"
done
if [ -n "$missing" ]; then
    printf 'Installing:%s\n' "$missing"
    if [ "$OSTREE" = 1 ]; then
        sudo rpm-ostree install $missing
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y $missing
    else
        printf 'No supported package manager; install these manually:%s\n' "$missing"
    fi
fi

# GUI applications come from Flathub; headless machines skip them entirely.
# This is the nix-config app set that has a maintained Flathub id. Discord is
# the stock client: Vencord's patcher is not a Flatpak and is left to the user.
if [ "$IS_HEADLESS" != "true" ] && command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists --user flathub \
        https://flathub.org/repo/flathub.flatpakrepo || true
    for app in \
        md.obsidian.Obsidian \
        com.brave.Browser \
        org.videolan.VLC \
        org.gimp.GIMP \
        org.gnome.Evince \
        com.transmissionbt.Transmission \
        com.discordapp.Discord \
        org.kde.krita \
        com.valvesoftware.Steam \
        com.bitwarden.desktop \
        com.tutanota.Tutanota \
        org.kde.dolphin; do
        flatpak info --user "$app" >/dev/null 2>&1 \
            || flatpak install --user -y --noninteractive flathub "$app" \
            || printf 'Flathub install failed for %s; install it by hand.\n' "$app"
    done
fi

# mise has no Fedora Atomic package that works without a reboot, so install the
# pinned release tarball directly. Both the URL tag and the sha256 are fixed in
# this file; a mismatch aborts before anything is unpacked, and no remote
# script is ever executed. Keep the checksums in step with the release's
# published SHASUMS256.txt and with dot_config/containers/Containerfile.dev.
if ! command -v mise >/dev/null 2>&1; then
    case "$(uname -m)" in
        x86_64) mise_arch=linux-x64
                mise_sha=d2d5a46f507bba772686e2c8f2316b3a4439dac49a37a30db5c0e7bb077c5431 ;;
        aarch64 | arm64) mise_arch=linux-arm64
                mise_sha=b36da3c4892380325d44dee3678ba618de191254d8a4aed8011ee66b28a6cbd7 ;;
        *) mise_arch="" ;;
    esac
    if [ -z "$mise_arch" ]; then
        printf 'unsupported architecture for the pinned mise release; install it by hand.\n'
    else
        mise_tmp=$(mktemp -d) || exit 1
        mise_url="https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-${mise_arch}.tar.gz"
        if curl -fsSL "$mise_url" -o "$mise_tmp/mise.tar.gz" \
            && echo "$mise_sha  $mise_tmp/mise.tar.gz" | sha256sum -c - >/dev/null 2>&1 \
            && tar -xzf "$mise_tmp/mise.tar.gz" -C "$mise_tmp" \
            && mkdir -p "$HOME/.local/bin"; then
            install -m 0755 "$mise_tmp/mise/bin/mise" "$HOME/.local/bin/mise" \
                || printf 'mise install failed; install it by hand.\n'
        else
            printf 'could not fetch or verify the pinned mise release; install it by hand.\n'
        fi
        rm -rf "$mise_tmp"
    fi
fi

if [ "$OSTREE" = 1 ]; then
    printf '\nLayered packages take effect after a reboot: systemctl reboot\n'
fi
{{ else if eq $os "darwin" -}}
# ---------------------------------------------------------------------- macOS
if ! command -v brew >/dev/null 2>&1; then
    printf 'Homebrew is required: install it from https://brew.sh, then re-run chezmoi apply.\n'
else
    # zellij, yazi, television, ghq, zoxide, and delta come from mise on both
    # OSes, so their pinned versions are the only ones that ever run.
    FORMULAE="fish zsh git git-lfs gh just mise ripgrep fd bat eza jq yq shellcheck yamllint kubeconform actionlint helix lazygit uv deno podman python rustup rsync zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search"
    missing=""
    for formula in $FORMULAE; do
        brew list --formula "$formula" >/dev/null 2>&1 || missing="$missing $formula"
    done
    if [ -n "$missing" ]; then
        printf 'Installing:%s\n' "$missing"
        brew install $missing
    fi

    # A Nerd font is what the terminal and helix are configured for; a headless
    # machine has no terminal that would use it. The GUI casks (kitty,
    # AeroSpace, Brave, Docker, …) live in ~/.config/homebrew/Brewfile and are
    # applied on request with `brew bundle`, so a first apply never asks for
    # Docker Desktop's privileged helper.
    if [ "$IS_HEADLESS" != "true" ]; then
        for cask in font-jetbrains-mono-nerd-font; do
            brew list --cask "$cask" >/dev/null 2>&1 \
                || brew install --cask "$cask" \
                || printf 'Cask install failed for %s; install it by hand.\n' "$cask"
        done
    fi
fi
{{ end -}}

print_followups
